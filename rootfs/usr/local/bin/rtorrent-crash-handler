#!/usr/bin/with-contenv sh
# shellcheck shell=sh
export HOME=/data/rtorrent
export PWD=/data/rtorrent

CRASH_DIR="${RT_CRASH_DIR:-/data/rtorrent/log}"
mkdir -p "${CRASH_DIR}"

STAMP="$(date +%Y%m%d-%H%M%S)"
CRASH_LOG="${CRASH_DIR}/rtorrent-crash-${STAMP}.log"
GDB_CMD="/tmp/rtorrent-crash-${STAMP}-$$.gdb"

cat > "${GDB_CMD}" <<EOF
set pagination off
set confirm off
set print thread-events off
run
if \$_siginfo
  printf "===== rtorrent crashed, generating crash dump =====\n"
  set logging file ${CRASH_LOG}
  set logging overwrite on
  set logging enabled on
  thread apply all bt full
  info registers
  set logging enabled off
  printf "Crash dump written to ${CRASH_LOG}\n"
else
  printf "rtorrent exited normally\n"
end
shell rm -f ${GDB_CMD}
quit
EOF

exec gdb -q -batch -x "${GDB_CMD}" --args rtorrent "$@"