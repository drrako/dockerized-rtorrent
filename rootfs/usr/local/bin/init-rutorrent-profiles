#!/bin/sh
set -eu

PHP_BIN=${RUTORRENT_INITPLUGINS_PHP:-/usr/bin/php85}
INITPLUGINS_SCRIPT=${RUTORRENT_INITPLUGINS_SCRIPT:-/var/www/rutorrent/php/initplugins.php}
AUTH_FILE=${RUTORRENT_HTPASSWD_FILE:-/passwd/rutorrent.htpasswd}

# ruTorrent collapses all authenticated users into the default profile when
# user settings are forbidden, so initialize that profile only once.
case "${RU_FORBID_USER_SETTINGS:-false}" in
	true|TRUE|1|yes|YES)
		exec env REMOTE_USER= "$PHP_BIN" "$INITPLUGINS_SCRIPT"
		;;
esac

profiles=${RUTORRENT_PROFILE_USERS:-}
if [ -n "$profiles" ]; then
	# Whitespace around list entries is formatting, not part of the username.
	profiles=$(printf '%s\n' "$profiles" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; /^$/d')
elif [ -r "$AUTH_FILE" ] && [ -s "$AUTH_FILE" ]; then
	# Preserve htpasswd usernames exactly, including leading/trailing whitespace.
	profiles=$(awk -F: 'NF >= 2 && $1 != "" && $1 !~ /^#/ { print $1 }' "$AUTH_FILE")
fi

# No configured users means the UI is using ruTorrent's default profile.
if [ -z "$profiles" ]; then
	exec env REMOTE_USER= "$PHP_BIN" "$INITPLUGINS_SCRIPT"
fi

# Match User::getUser() normalization so startup and authenticated web
# requests register the same profile-specific rTorrent handlers.
export LC_ALL=C
seen=' '
printf '%s\n' "$profiles" | while IFS= read -r username; do
	[ -n "$username" ] || continue
	profile=$(printf '%s' "$username" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]/_/g')
	[ -n "$profile" ] || continue
	case "$seen" in
		*" $profile "*) continue ;;
	esac
	seen="${seen}${profile} "
	"$PHP_BIN" "$INITPLUGINS_SCRIPT" "$profile" || exit 1
done
